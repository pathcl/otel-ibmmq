{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "OTel IBM MQ Servicegraph",
  "id": "otel-mq",
  "info": {
    "keywords": ["app", "otel", "ibmmq", "servicegraph"],
    "description": "Service graph with baggage propagation across IBM MQ / JMS spans.",
    "author": {
      "name": "Tutorial"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Service Graph",
      "path": "/a/%PLUGIN_ID%/home",
      "addToNav": true,
      "defaultNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
