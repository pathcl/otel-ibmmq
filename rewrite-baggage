#!/usr/bin/env bash
# rewrite-baggage — update Tempo dimensions to match a new baggage attribute set.
#
# Usage: ./rewrite-baggage attr1 attr2 [attr3 ...]
#
# Services automatically forward every X-* HTTP header into W3C Baggage and
# set all baggage entries as span attributes — no service changes are needed.
# This script only updates the Tempo dimensions list so the new attributes
# appear as Prometheus labels in service-graph and span metrics.
#
# After running, restart Tempo to apply:
#   docker compose -f labs/otel-ibmmq/docker-compose.yml up -d tempo
#
# Example — add region.id without rebuilding any service:
#   ./rewrite-baggage tenant.id user.id region.id
#   docker compose -f labs/otel-ibmmq/docker-compose.yml up -d tempo
#   curl -X POST http://localhost:8081/order \
#     -H "X-Tenant-ID: acme" -H "X-User-ID: u1" -H "X-Region-ID: eu-west-1"

set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: $0 attr1 attr2 [attr3 ...]" >&2
  echo "Example: $0 tenant.id user.id region.id" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

python3 - "$@" << 'EOF'
import sys, re

attrs = sys.argv[1:]
indent = "        "
lines = "\n".join(f"{indent}- {a}" for a in attrs) + "\n"

path = "labs/otel-ibmmq/tempo/tempo.yaml"
src = open(path).read()

# Replace dimensions list under service_graphs processor
src = re.sub(
    r'(    service_graphs:\n      dimensions:\n)(?:        - .+\n)+',
    r'\g<1>' + lines,
    src
)
# Replace dimensions list under span_metrics processor
src = re.sub(
    r'(    span_metrics:\n      dimensions:\n)(?:        - .+\n)+',
    r'\g<1>' + lines,
    src
)

open(path, "w").write(src)
print(f"tempo.yaml dimensions updated: {attrs}")
print("Restart Tempo: docker compose -f labs/otel-ibmmq/docker-compose.yml up -d tempo")
EOF
